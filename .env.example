# Copy to .env and fill in. Never commit the real file.

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Optional. Without it the bot still works; it just loses its AI flavouring and chat,
# falling back to the hand-written lines for every message.
OPENAI_API_KEY=

# Your own Telegram user id (ask @userinfobot). Failure alerts and nightly backups go here.
ADMIN_CHAT_ID=

# Who may use /admin. Comma-separated; overrides `admins` in config/app.yaml.
ADMIN_IDS=

# Paths. The defaults match the Docker image and rarely need changing.
# TABELSHCHIK_CONFIG=/app/config
# TABELSHCHIK_DB=/data/tabelshchik.db
