# Copy to .env and fill in. Never commit the real file.

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Optional. Without it the bot still works; it just loses its AI flavouring and chat,
# falling back to the hand-written lines for every message.
OPENAI_API_KEY=

# Where failure alerts and nightly backups go. Optional — it defaults to the owner's own
# Telegram id. Keep it set anyway: scripts/deploy.sh reads this file directly to report a
# failed deploy, and it cannot reach the database.
ADMIN_CHAT_ID=

# Seeds the admin table on the FIRST boot only, lowest id becoming the owner. Once
# anybody is an admin, adminship is managed from /admin and this does nothing — which is
# what lets an owner hand the bot over and then stop being an admin. Comma-separated.
ADMIN_IDS=

# Paths. The defaults match the Docker image and rarely need changing.
# TABELSHCHIK_CONFIG=/app/config
# TABELSHCHIK_DB=/data/tabelshchik.db
